{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "Dockerfile"
  },
  "deploy": {
    "startCommand": "clawfront start --port 3000 --root-dir /data",
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10,
    "volumes": [
      {
        "mountPath": "/data"
      }
    ],
    "variables": {
      "CLAWFRONT_REGISTRY_TOKEN": {
        "description": "GitHub PAT with read:packages scope for accessing the clawfront registry",
        "required": true
      },
      "SETUP_PASSWORD": {
        "description": "Password for initial setup access",
        "required": true
      }
    }
  }
}
